# SyncForge — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# All VITE_ prefixed vars are embedded at build time and visible to the browser.

# ── API Server ────────────────────────────────────────────────────────────────
# URL of the SyncForge backend. In development this is proxied by Vite,
# but it is used directly for OAuth redirects and Socket.io connections.
# Leave empty in dev (Vite proxy handles /api automatically).
VITE_API_URL=http://localhost:5000

# ── Cloudinary (Avatar Uploads) ───────────────────────────────────────────────
# Your Cloudinary cloud name (find it in the Cloudinary dashboard).
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# An unsigned upload preset configured in Cloudinary (Settings → Upload Presets).
# Use an unsigned preset; never expose signed upload credentials in the frontend.
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
